# =============================================================================
# zen-ai-stack — Environment Configuration
# Copia este archivo a .env y ajusta los valores
# =============================================================================

# --- Puertos Host ---
HOST_PORT_OLLAMA=11434
HOST_PORT_OPENWEBUI=3000
HOST_PORT_COMFYUI=8188
HOST_PORT_PORTAINER=9443

# --- Open WebUI ---
WEBUI_SECRET_KEY=cambia-este-valor-por-uno-seguro

# --- Open WebUI → ComfyUI (imágenes) ---
ENABLE_IMAGE_GENERATION=true
IMAGE_GENERATION_ENGINE=comfyui
COMFYUI_BASE_URL=http://comfyui:8188
IMAGE_SIZE=1024x1024
IMAGE_STEPS=30
ENABLE_IMAGE_PROMPT_GENERATION=true
USER_PERMISSIONS_FEATURES_IMAGE_GENERATION=true

# --- Modelos Ollama (separados por coma) ---
OLLAMA_MODELS=qwen2.5-coder:7b,llama3.2-vision:11b,llama3.2:3b,nomic-embed-text,deepseek-coder-v2:16b

# --- screenshot-to-code (perfil full) ---
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
